{
  "schema_version": "stage-experiment-governance-v1",
  "protocol": "stage-10subset-seed2026-v1",
  "seed": 2026,
  "official_split": "TSB-AD Tuning/Eval",
  "baseline_policy": {
    "additional_hyperparameter_search": false,
    "parameter_source_priority": [
      "paper_reported",
      "author_released",
      "official_tsb_ad_tuning",
      "predeclared_stability_default"
    ],
    "stability_default_rule": "Allowed only when no matching reported or released setting exists; document the exact values and rationale, freeze their hash before Eval, and never use Eval metrics to choose them.",
    "eval_feedback": false
  },
  "stage_tuning_policy": {
    "data": "official TSB-AD Tuning only",
